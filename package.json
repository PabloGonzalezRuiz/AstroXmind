{
  "name": "astro-xmind",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node --test tests/navigation-rendered.test.mjs tests/reference-client.test.mjs tests/wiki-editor.test.mjs tests/oposiciones.test.mjs",
    "preview": "astro preview",
    "package:wiki": "npm run build && node scripts/package-local-wiki.mjs",
    "check": "npm run navigation:check && npm run test:navigation && npm run test:catalog && npm run test:transform && npm run test:programa && npm run test:editor-programa && astro check",
    "navigation:check": "node scripts/navigation.mjs check",
    "navigation:id": "node scripts/navigation.mjs id",
    "test:navigation": "node --test tests/navigation.test.mjs tests/references.test.mjs tests/navigation-order.test.mjs",
    "test:catalog": "node --test tests/component-catalog.test.mjs",
    "test:transform": "node --test tests/component-transform.test.mjs",
    "test:references:rebuild": "node --test tests/reference-rebuild.test.mjs",
    "test:navigation:ordering": "node --test tests/navigation-order-rebuild.test.mjs",
    "test:programa": "node --test tests/programa-oficial.test.mjs tests/programa-generacion.test.mjs",
    "test:editor-programa": "node --test tests/editor-programa.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.16.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdx": "3.0.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "node-html-parser": "^9.0.7",
    "pdfjs-dist": "4.10.38",
    "remark-directive": "^4.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "ajv": "8.20.0",
    "jsdom": "26.1.0",
    "typescript": "^5.8.0"
  }
}
