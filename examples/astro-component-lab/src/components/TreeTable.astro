---
import { buildTreeTableRows, renderTreeTableHtml, type Props } from './tree-table-model';
import './tree-table.css';
const props: Props = Astro.props;
const rows = buildTreeTableRows(await Astro.slots.render('default'), props);
---
<Fragment set:html={renderTreeTableHtml(rows)} />
<script>
  import './tree-table-client';
</script>
