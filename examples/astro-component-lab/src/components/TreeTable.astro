---
import { parse } from 'node-html-parser';

type HtmlNode = {
  tagName?: string;
  childNodes?: unknown[];
  rawText?: string;
  text?: string;
  getAttribute?: (name: string) => string | undefined;
};
type Numbering = { enabled?: boolean; tiered?: boolean; start?: number };
type TreeNode = { referenceId?: string; labelHtml: string; children: TreeNode[]; numbering?: Numbering; numberLabel?: string; collapsible?: boolean; folded?: boolean; key?: string; parent?: string; nodeClass?: string; resolvedClass?: string };
type TableCell = { referenceId?: string; labelHtml: string; level: number; numberLabel?: string; rowspan?: number; colspan?: number; key: string; parent: string; collapsible: boolean; folded: boolean; resolvedClass?: string };
type NumberingMode = 'none' | 'siblings' | 'path';
interface Props { numbering?: NumberingMode; collapsible?: boolean | 'true' | 'false'; folded?: boolean | 'true' | 'false'; levelClasses?: string }

const { numbering = 'none', collapsible = false, folded = false, levelClasses = '' } = Astro.props;
if (![true, false, 'true', 'false'].includes(collapsible)) {
  throw new Error('TreeTable: collapsible debe ser true o false.');
}
if (![true, false, 'true', 'false'].includes(folded)) {
  throw new Error('TreeTable: folded debe ser true o false.');
}
const defaultFolded = folded === true || folded === 'true';
const defaultCollapsible = collapsible === true || collapsible === 'true';
if (!['none', 'siblings', 'path'].includes(numbering)) {
  throw new Error('TreeTable: numbering debe ser none, siblings o path.');
}

// Class names remain CSS tokens, not executable style expressions.
function validateClass(value: string): string {
  if (value !== 'none' && !/^[A-Za-z_][A-Za-z0-9_-]*$/.test(value)) {
    throw new Error('TreeTable: class debe ser un nombre CSS (letras, números, guion o guion bajo) o none.');
  }
  return value;
}
function parseLevelClasses(value: string): Map<number, string> {
  if (typeof value !== 'string') throw new Error('TreeTable: levelClasses debe ser una cadena nivel:Clase separada por punto y coma.');
  const levels = new Map<number, string>();
  if (!value.trim()) return levels;
  for (const entry of value.split(/[;,]/)) {
    const match = entry.trim().match(/^(0|[1-9]\d*)\s*:\s*([A-Za-z_][A-Za-z0-9_-]*)$/);
    if (!match || !Number.isSafeInteger(Number(match[1]))) throw new Error('TreeTable: levelClasses debe contener niveles enteros desde 0 y nombres CSS válidos.');
    const level = Number(match[1]);
    if (levels.has(level)) throw new Error(`TreeTable: nivel duplicado en levelClasses: ${level}.`);
    levels.set(level, validateClass(match[2]));
  }
  return levels;
}
const configuredClasses = parseLevelClasses(levelClasses);
function assignClasses(nodes: TreeNode[], level = 0, inherited?: string): void {
  for (const node of nodes) {
    node.resolvedClass = node.nodeClass ?? configuredClasses.get(level) ?? inherited;
    assignClasses(node.children, level + 1, node.resolvedClass);
  }
}

function isElement(node: unknown): node is HtmlNode & { tagName: string } {
  return typeof node === 'object' && node !== null
    && typeof (node as HtmlNode).tagName === 'string';
}
const listTags = new Set(['UL', 'OL']);
const inlineTags = new Set(['b', 'strong', 'i', 'em', 'code', 'kbd', 'samp', 'sub', 'sup', 'del', 'ins', 'span', 'br']);

function escapeAttribute(value: string): string {
  return value.replaceAll('&', '&amp;').replaceAll('"', '&quot;')
    .replaceAll('<', '&lt;').replaceAll('>', '&gt;');
}
function safeHref(value: string): boolean {
  const href = value.trim();
  return /^(https?:|mailto:|#)/i.test(href)
    || href.startsWith('/') || href.startsWith('./') || href.startsWith('../');
}

function renderInline(node: unknown): string {
  if (!isElement(node)) {
    const textNode = node as { rawText?: string; text?: string } | null;
    if (!textNode) return '';
    return textNode.rawText ?? escapeAttribute(textNode.text ?? '');
  }
  const tag = node.tagName.toLowerCase();
  if (listTags.has(node.tagName)) return '';
  const content = (node.childNodes ?? []).map(renderInline).join('');
  if (tag === 'a') {
    const href = node.getAttribute?.('href') ?? '';
    const reference = node.getAttribute?.('data-doc-reference');
    return safeHref(href) ? `<a href="${escapeAttribute(href)}"${reference ? ` data-doc-reference="${escapeAttribute(reference)}"` : ''}>${content}</a>` : content;
  }
  if (!inlineTags.has(tag)) return content;
  if (tag === 'br') return '<br />';
  return `<${tag}>${content}</${tag}>`;
}

function extractAttributes(labelHtml: string): { referenceId?: string; labelHtml: string; numbering?: Numbering; collapsible?: boolean; folded?: boolean; nodeClass?: string } {
  // Only a trailing, plain-text annotation is metadata; inline code stays literal.
  const match = labelHtml.match(/\s+\[([^<>\[\]]+)\]\s*$/);
  if (!match || !/\b(?:numbering|tiered|start|collapsible|folded|class|id)\s*=/.test(match[1])) return { labelHtml };
  const options: Record<string, string> = {};
  for (const entry of match[1].split(/[;,]/)) {
    const option = entry.trim().match(/^(numbering|tiered|start|collapsible|folded|class|id)\s*=\s*([^\s]+)$/);
    if (!option || option[1] in options) throw new Error('TreeTable: propiedad desconocida, duplicada o mal formada en la anotación.');
    options[option[1]] = option[2];
  }
  for (const name of ['tiered', 'collapsible', 'folded']) {
    if (options[name] !== undefined && !['true', 'false'].includes(options[name])) {
      throw new Error(`TreeTable: ${name} debe ser true o false.`);
    }
  }
  if (options.numbering !== undefined && !['arabic', 'none'].includes(options.numbering)) throw new Error('TreeTable: numbering de nodo debe ser arabic o none.');
  const start = options.start === undefined ? undefined : Number(options.start);
  if (start !== undefined && (!/^[0-9]+$/.test(options.start) || !Number.isSafeInteger(start) || start < 1)) {
    throw new Error('TreeTable: start de numeración debe ser un entero mayor que cero.');
  }
  if (options.id !== undefined && !/^ref-[a-z][a-z0-9-]*$/.test(options.id)) {
    throw new Error('TreeTable: id debe tener formato ref-nombre, con letras minúsculas, números y guiones.');
  }
  return {
    referenceId: options.id,
    labelHtml: labelHtml.slice(0, match.index).trimEnd(),
    numbering: options.numbering !== undefined || options.tiered !== undefined || start !== undefined
      ? { enabled: options.numbering === undefined ? undefined : options.numbering === 'arabic', tiered: options.tiered === undefined ? undefined : options.tiered === 'true', start }
      : undefined,
    collapsible: options.collapsible === undefined ? undefined : options.collapsible === 'true',
    folded: options.folded === undefined ? undefined : options.folded === 'true',
    nodeClass: options.class === undefined ? undefined : validateClass(options.class),
  };
}

function parseList(list: HtmlNode): TreeNode[] {
  const items = (list.childNodes ?? []).filter(
    (node): node is HtmlNode & { tagName: string } => isElement(node) && node.tagName === 'LI',
  );
  return items.map((li) => {
    const nestedLists = (li.childNodes ?? []).filter(
      (node): node is HtmlNode & { tagName: string } => isElement(node) && listTags.has(node.tagName),
    );
    const rawLabel = (li.childNodes ?? [])
      .filter((node) => !(isElement(node) && listTags.has(node.tagName)))
      .map(renderInline).join('').trim();
    const { labelHtml, numbering: parsedNumbering, collapsible: nodeCollapsible, folded: nodeFolded, nodeClass, referenceId } = extractAttributes(rawLabel);
    if (!labelHtml) throw new Error('TreeTable: cada elemento debe tener contenido.');
    const children = nestedLists.flatMap(parseList);
    return { referenceId, labelHtml, children, numbering: parsedNumbering, numberLabel: undefined, collapsible: nodeCollapsible, folded: nodeFolded, nodeClass };
  });
}

function assignNumbering(nodes: TreeNode[], parentPath: number[] = [], inherited = { enabled: false, tiered: false }): void {
  let current = 0;
  for (const node of nodes) {
    const enabled = node.numbering?.enabled ?? inherited.enabled;
    const tiered = node.numbering?.tiered ?? inherited.tiered;
    if (!enabled && (node.numbering?.start !== undefined || node.numbering?.tiered !== undefined)) {
      throw new Error('TreeTable: start y tiered requieren numeración activa, propia o heredada.');
    }
    // An unnumbered parent breaks the tiered path for its descendants.
    let nextPath: number[] = [];
    if (enabled) {
      const value = node.numbering?.start ?? current + 1;
      current = value;
      const fullPath = [...parentPath, value];
      node.numberLabel = numbering === 'path' && tiered
        ? `${fullPath.join('.')}.`
        : `${value}.`;
      nextPath = fullPath;
    }
    assignNumbering(node.children, nextPath, { enabled, tiered });
  }
}

const htmlSlot = await Astro.slots.render('default');
const parsedSlot = parse(htmlSlot) as unknown as HtmlNode;
const rootLists = (parsedSlot.childNodes ?? []).filter(
  (node): node is HtmlNode & { tagName: string } => isElement(node) && listTags.has(node.tagName),
);
if (rootLists.length !== 1) {
  throw new Error('TreeTable: el slot MDX debe contener exactamente una lista jerárquica.');
}
const tree = parseList(rootLists[0]);
if (!tree.length) throw new Error('TreeTable: la lista debe contener al menos un nodo.');
assignNumbering(tree);
assignClasses(tree);
let nextKey = 0;
const referenceIds = new Set<string>();
function inheritCollapsible(nodes: TreeNode[], inherited: boolean, inheritedFolded: boolean, parent = ''): void {
  for (const node of nodes) {
    if (node.referenceId) {
      if (referenceIds.has(node.referenceId)) throw new Error(`TreeTable: id duplicado ${node.referenceId}.`);
      referenceIds.add(node.referenceId);
    }
    node.key = String(nextKey++);
    node.parent = parent;
    node.collapsible = node.collapsible ?? inherited;
    node.folded = node.folded ?? inheritedFolded;
    inheritCollapsible(node.children, node.collapsible, node.folded, node.key);
  }
}
inheritCollapsible(tree, defaultCollapsible, defaultFolded);

const spans = new Map<TreeNode, number>();
let depth = 0;
function measure(node: TreeNode, level: number): number {
  depth = Math.max(depth, level + 1);
  const span = node.children.reduce((sum, child) => sum + measure(child, level + 1), 0) || 1;
  spans.set(node, span);
  return span;
}
const rowCount = tree.reduce((total, node) => total + measure(node, 0), 0);
const rows: TableCell[][] = Array.from({ length: rowCount }, () => []);

function place(node: TreeNode, level: number, firstRow: number): void {
  const span = spans.get(node)!;
  const isLeaf = node.children.length === 0;
  const colspan = isLeaf ? Math.max(1, depth - level) : undefined;
  rows[firstRow].push({
    labelHtml: node.labelHtml, referenceId: node.referenceId,
    key: node.key!, parent: node.parent!, collapsible: Boolean(node.collapsible && node.children.length),
    folded: Boolean(node.folded && node.collapsible && node.children.length),
    level, resolvedClass: node.resolvedClass,
    numberLabel: numbering === 'none' ? undefined : node.numberLabel,
    rowspan: span > 1 ? span : undefined,
    colspan: colspan && colspan > 1 ? colspan : undefined,
  });
  let childRow = firstRow;
  for (const child of node.children) {
    place(child, level + 1, childRow);
    childRow += spans.get(child)!;
  }
}
let firstRow = 0;
for (const node of tree) {
  place(node, 0, firstRow);
  firstRow += spans.get(node)!;
}
---
<astro-xmind-tree-table>
<div class="tree-table-frame">
<div class="tree-table-scroll" role="region" aria-label="Tabla jerárquica" tabindex="0">
  <table class="xmind-tree-table">
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell) => (
            <td id={cell.referenceId} data-tree-folded={cell.folded ? 'true' : undefined} data-tree-class={cell.resolvedClass && cell.resolvedClass !== 'none' ? cell.resolvedClass : undefined} data-tree-key={cell.key} data-tree-parent={cell.parent} data-tree-level={cell.level} rowspan={cell.rowspan} colspan={cell.colspan} class:list={[`nivel-${cell.level}`, cell.resolvedClass !== 'none' && cell.resolvedClass]}>
              {cell.collapsible && <button class="tree-toggle" type="button" aria-expanded="true" aria-label="Plegar rama" hidden><span aria-hidden="true">−</span></button>}
              {cell.numberLabel && <span class="tree-number">{cell.numberLabel}</span>}
              <Fragment set:html={cell.labelHtml} />
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
  <button class="tree-fullscreen" type="button" aria-label="Ver tabla a pantalla completa" title="Ver tabla a pantalla completa" aria-pressed="false" hidden>
    <svg class="fullscreen-expand" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5" /></svg>
    <svg class="fullscreen-contract" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h5V3M16 3v5h5M3 16h5v5M16 21v-5h5" /></svg>
  </button>
</div>
</astro-xmind-tree-table>

<script>
  interface TreeReadingState { folded: string[]; x: number; y: number }
  class AstroXmindTreeTable extends HTMLElement {
    captureReadingState?: () => TreeReadingState;
    restoreReadingState?: (state: TreeReadingState) => void;
    private findAndReveal?: (id: string) => HTMLElement | null;
    revealTarget(id: string): HTMLElement | null { return this.findAndReveal?.(id) ?? null; }
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const frame = this.querySelector<HTMLElement>('.tree-table-frame')!;
      const fullscreenButton = this.querySelector<HTMLButtonElement>('.tree-fullscreen')!;
      let previousOverflow = '';
      let previousFocus: HTMLElement | null = null;
      let pendingFullscreen = false;
      const isFullscreen = () => document.fullscreenElement === frame || frame.classList.contains('is-fullscreen');
      const updateFullscreen = () => {
        const active = isFullscreen();
        const label = active ? 'Salir de pantalla completa (Escape)' : 'Ver tabla a pantalla completa';
        fullscreenButton.setAttribute('aria-pressed', String(active));
        fullscreenButton.setAttribute('aria-label', label);
        fullscreenButton.title = label;
        if (active) fullscreenButton.focus({ preventScroll: true });
        else if (previousFocus?.isConnected) previousFocus.focus({ preventScroll: true });
      };
      const exitFallback = () => {
        frame.classList.remove('is-fullscreen');
        frame.removeAttribute('role');
        frame.removeAttribute('aria-modal');
        frame.removeAttribute('aria-label');
        document.body.style.overflow = previousOverflow;
        updateFullscreen();
      };
      fullscreenButton.hidden = false;
      fullscreenButton.addEventListener('click', async () => {
        if (pendingFullscreen) return;
        pendingFullscreen = true;
        try {
          if (frame.classList.contains('is-fullscreen')) { exitFallback(); return; }
          if (document.fullscreenElement === frame) { await document.exitFullscreen(); return; }
          previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : fullscreenButton;
          if (document.fullscreenEnabled && frame.requestFullscreen) {
            try { await frame.requestFullscreen(); updateFullscreen(); return; }
            catch { /* Browser policy may reject fullscreen; expand within the viewport instead. */ }
          }
          previousOverflow = document.body.style.overflow;
          document.body.style.overflow = 'hidden';
          frame.classList.add('is-fullscreen');
          frame.setAttribute('role', 'dialog');
          frame.setAttribute('aria-modal', 'true');
          frame.setAttribute('aria-label', 'Tabla a pantalla completa');
          updateFullscreen();
        } finally { pendingFullscreen = false; }
      });
      frame.addEventListener('fullscreenchange', updateFullscreen);
      frame.addEventListener('keydown', (event) => {
        if (!frame.classList.contains('is-fullscreen')) return;
        if (event.key === 'Escape') { event.preventDefault(); exitFallback(); }
        if (event.key === 'Tab') {
          const focusable = Array.from(frame.querySelectorAll<HTMLElement>('button:not([hidden]), a[href], [tabindex="0"]'))
            .filter(element => !element.closest('[hidden]'));
          const first = focusable[0], last = focusable.at(-1);
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
        }
      });
      const body = this.querySelector('tbody')!;
      const cells = Array.from(body.querySelectorAll<HTMLTableCellElement>('td[data-tree-key]'));
      const children = new Map<string, HTMLTableCellElement[]>();
      const collapsed = new Set(cells.filter(cell => cell.dataset.treeFolded === 'true').map(cell => cell.dataset.treeKey!));
      let depth = 0;
      for (const cell of cells) {
        const parent = cell.dataset.treeParent!;
        let siblings = children.get(parent);
        if (!siblings) {
          siblings = [];
          children.set(parent, siblings);
        }
        siblings.push(cell);
        depth = Math.max(depth, Number(cell.dataset.treeLevel) + 1);
      }
      const redraw = () => {
        const rows: HTMLTableCellElement[][] = [];
        const place = (cell: HTMLTableCellElement, firstRow: number): number => {
          const key = cell.dataset.treeKey!;
          const descendants = collapsed.has(key) ? [] : (children.get(key) ?? []);
          (rows[firstRow] ??= []).push(cell);
          let span = 0;
          for (const child of descendants) span += place(child, firstRow + span);
          span = Math.max(1, span);
          cell.rowSpan = span;
          cell.colSpan = descendants.length ? 1 : depth - Number(cell.dataset.treeLevel);
          return span;
        };
        let row = 0;
        for (const root of children.get('') ?? []) row += place(root, row);
        body.replaceChildren(...rows.map(cells => {
          const tr = document.createElement('tr');
          tr.append(...cells);
          return tr;
        }));
      };
      const scroller = this.querySelector<HTMLElement>('.tree-table-scroll')!;
      const syncToggle = (cell: HTMLTableCellElement) => {
        const button = cell.querySelector<HTMLButtonElement>('.tree-toggle');
        if (!button) return;
        const expanded = !collapsed.has(cell.dataset.treeKey!);
        button.setAttribute('aria-expanded', String(expanded));
        button.setAttribute('aria-label', expanded ? 'Plegar rama' : 'Desplegar rama');
        button.querySelector('span')!.textContent = expanded ? '−' : '+';
      };
      this.captureReadingState = () => ({ folded: [...collapsed], x: scroller.scrollLeft, y: scroller.scrollTop });
      this.restoreReadingState = ({ folded, x, y }) => {
        collapsed.clear();
        const foldedKeys = new Set(folded);
        for (const cell of cells) {
          if (foldedKeys.has(cell.dataset.treeKey!)) collapsed.add(cell.dataset.treeKey!);
          syncToggle(cell);
        }
        redraw();
        scroller.scrollLeft = x;
        scroller.scrollTop = y;
      };
      for (const cell of cells) {
        const button = cell.querySelector<HTMLButtonElement>('.tree-toggle');
        if (!button) continue;
        button.hidden = false;
        syncToggle(cell);
        button.addEventListener('click', () => {
          const key = cell.dataset.treeKey!;
          if (collapsed.has(key)) collapsed.delete(key); else collapsed.add(key);
          syncToggle(cell);
          const hadFocus = document.activeElement === button;
          redraw();
          if (hadFocus) button.focus({ preventScroll: true });
        });
      }
      this.findAndReveal = (id) => {
        // Folded cells are detached from the DOM but remain in this instance's map.
        let target: HTMLElement | undefined;
        const cell = cells.find(candidate => {
          target = candidate.id === id ? candidate : Array.from(candidate.querySelectorAll<HTMLElement>('[id]'))
            .find(element => element.id === id);
          return target !== undefined;
        });
        if (!cell) return null;
        const byKey = new Map(cells.map(cell => [cell.dataset.treeKey!, cell]));
        let parent = cell.dataset.treeParent;
        while (parent) {
          collapsed.delete(parent);
          const ancestor = byKey.get(parent)!;
          syncToggle(ancestor);
          parent = ancestor.dataset.treeParent;
        }
        redraw();
        return target ?? null;
      };
      if (collapsed.size) redraw();
    }
  }
  if (!customElements.get('astro-xmind-tree-table')) customElements.define('astro-xmind-tree-table', AstroXmindTreeTable);
</script>

<style>
  astro-xmind-tree-table { display: block; }
  .tree-table-frame { position: relative; margin-block: 1.5rem; }
  .tree-fullscreen { position: absolute; top: 0.4rem; right: 0.4rem; z-index: 2; display: inline-grid; place-items: center; width: 2rem; height: 2rem; margin: 0; padding: 0; border: 1px solid var(--sl-color-gray-4, #64748b); border-radius: 0.35rem; color: var(--sl-color-text, #0f172a); background: var(--sl-color-bg, #fff); box-shadow: 0 1px 4px #0002; cursor: pointer; opacity: 0; pointer-events: none; transition: opacity 120ms ease; }
  .tree-fullscreen[hidden] { display: none; }
  .tree-table-frame:hover > .tree-fullscreen, .tree-table-frame:focus-within > .tree-fullscreen { opacity: 1; pointer-events: auto; }
  .tree-fullscreen:focus-visible { outline: 2px solid var(--sl-color-text-accent, #0369a1); outline-offset: 3px; }
  .fullscreen-contract { display: none; }
  .tree-fullscreen[aria-pressed="true"] .fullscreen-expand { display: none; }
  .tree-fullscreen[aria-pressed="true"] .fullscreen-contract { display: block; }
  .tree-table-frame:fullscreen, .tree-table-frame.is-fullscreen { display: block; box-sizing: border-box; width: 100%; height: 100dvh; max-width: none; margin: 0; padding: 3rem 1rem 1rem; color: var(--sl-color-text, #0f172a); background: var(--sl-color-bg, #fff); }
  .tree-table-frame.is-fullscreen { position: fixed; inset: 0; z-index: 2147483000; }
  .tree-table-frame:fullscreen > .tree-fullscreen, .tree-table-frame.is-fullscreen > .tree-fullscreen { opacity: 1; pointer-events: auto; }
  .tree-table-frame:fullscreen > .tree-table-scroll, .tree-table-frame.is-fullscreen > .tree-table-scroll { display: flex; box-sizing: border-box; width: 100%; height: 100%; padding: 0.25rem; overflow: auto; border: 0; border-radius: 0; }
  /* Auto margins center only spare space; overflow remains reachable from its origin. */
  .tree-table-frame:fullscreen .xmind-tree-table, .tree-table-frame.is-fullscreen .xmind-tree-table { display: table; flex: none; width: max-content; max-width: 100%; margin: auto; overflow: visible; }
  @media (hover: none), (pointer: coarse) { .tree-fullscreen { opacity: 1; pointer-events: auto; } }
  @media (prefers-reduced-motion: reduce) { .tree-fullscreen { transition: none; } }
  .tree-toggle { position: absolute; top: 0.2rem; left: 0.2rem; display: inline-grid; place-items: center; box-sizing: border-box; width: 1rem; height: 1rem; min-width: 0; min-height: 0; margin: 0; padding: 0; font-size: 0.75rem; line-height: 1; color: inherit; background: transparent; border: 1px solid currentColor; border-radius: 0.2rem; cursor: pointer; }
  .xmind-tree-table td:has(> .tree-toggle:not([hidden])) { padding-top: 1.5rem; }
  .tree-toggle[hidden] { display: none; }
  .tree-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .tree-table-scroll { max-width: 100%; overflow-x: auto; margin: 0; border: 1px solid #64748b; border-radius: 0.6rem; }
  .xmind-tree-table { width: 100%; min-width: 42rem; border-collapse: collapse; table-layout: auto; }
  .xmind-tree-table td { position: relative; min-width: 8rem; border: 1px solid #64748b; padding: 0.65rem 1rem; vertical-align: middle; overflow-wrap: normal; word-break: normal; }
  .xmind-tree-table td :global(p) { margin: 0.2rem 0; }
  .tree-number { display: inline-block; margin-right: 0.4em; font-weight: 700; white-space: nowrap; }
  .nivel-0:not([data-tree-class]) { background: #1e293b; color: #fff; font-weight: 700; font-size: 1.15rem; }
  .nivel-1:not([data-tree-class]) { background: #e2e8f0; color: #0f172a; font-weight: 700; }
  .nivel-2:not([data-tree-class]) { background: #f8fafc; color: #0369a1; }
