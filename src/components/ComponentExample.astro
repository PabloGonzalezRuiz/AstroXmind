---
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';
import FrameEjemplo from './FrameEjemplo.astro';
interface Props {
  source: string;
  language?: string;
  filename?: string;
  implementation?: string;
  stylesheet?: string;
  practice?: boolean;
}
const { source, language = 'mdx', filename = 'Ejemplo.mdx', implementation, stylesheet, practice = false } = Astro.props;
const practiceId = filename.replace(/[^a-zA-Z0-9_-]/g, '-');
---
<div class="component-example" data-example-file={filename}>
  {practice && <p class="reference-label"><strong>Ejemplo original</strong> · Solo lectura</p>}
  <Tabs>
    <TabItem label="Resultado"><div class="example-result"><slot /></div></TabItem>
    <TabItem label="Código">
      <Code code={source} lang={language} title={filename} />
      {stylesheet && <Code code={stylesheet} lang="css" title="article-example.css" />}
      {implementation && <Code code={implementation} lang="astro" title="Panel.astro" />}
    </TabItem>
  </Tabs>
</div>
{practice && <FrameEjemplo example={`tree-table/${filename.replace(/\.mdx$/, '')}`} id={practiceId} />}
<style>
  .component-example { min-width: 0; margin-block: 1.5rem; padding: 0.75rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.6rem; }
  .example-result { min-width: 0; }
  .example-result :global(.tree-table-scroll) { margin-block: 0.5rem; }
  .reference-label { font-size: .85rem; color: var(--sl-color-gray-2); margin: 0 0 .5rem; }
</style>
