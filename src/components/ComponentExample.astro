---
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';
interface Props {
  source: string;
  language?: string;
  filename?: string;
  implementation?: string;
  stylesheet?: string;
}
const { source, language = 'mdx', filename = 'Ejemplo.mdx', implementation, stylesheet } = Astro.props;
---
<div class="component-example">
  <Tabs>
    <TabItem label="Resultado"><div class="example-result"><slot /></div></TabItem>
    <TabItem label="Código">
      <Code code={source} lang={language} title={filename} />
      {stylesheet && <Code code={stylesheet} lang="css" title="article-example.css" />}
      {implementation && <Code code={implementation} lang="astro" title="Panel.astro" />}
    </TabItem>
  </Tabs>
</div>
<style>
  .component-example { min-width: 0; margin-block: 1.5rem; padding: 0.75rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.6rem; }
  .example-result { min-width: 0; }
  .example-result :global(.tree-table-scroll) { margin-block: 0.5rem; }
</style>
