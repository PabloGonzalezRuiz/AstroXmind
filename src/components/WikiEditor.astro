---
const example = `## Mi nota de prueba

Escribe aquí y comprueba cómo cambia el resultado.

| Tema | Estado |
| --- | --- |
| Títulos | Pendiente |
| Tablas | Pendiente |

- Una idea
- Otra idea

[Ir a la guía de TreeTable](../componentes/tree-table/)
`;
---
<div class="wiki-editor" data-wiki-editor data-pagefind-ignore data-active-view="edit">
  <div class="editor-toolbar">
    <div class="editor-views" role="group" aria-label="Panel visible">
      <button type="button" data-editor-view="edit" aria-pressed="true">Editar</button>
      <button type="button" data-editor-view="result" aria-pressed="false">Resultado</button>
    </div>
    <button type="button" data-editor-save disabled>Guardar borrador</button>
    <button type="button" data-editor-download disabled>Descargar Markdown</button>
  </div>
  <div class="editor-toolbar editor-pat" data-editor-pat>
    <button type="button" data-pat-save disabled>Guardar en GitHub</button>
    <label for="wiki-github-token">Token</label>
    <input id="wiki-github-token" type="password" autocomplete="off" spellcheck="false" placeholder="Token de GitHub" data-pat-token />
    <button type="button" data-pat-store>Guardar token</button>
    <button type="button" data-pat-load disabled>Abrir borrador de GitHub</button>
    <button type="button" data-pat-disconnect disabled>Olvidar token</button>
    <a data-pat-result hidden>Ver commit en GitHub</a>
    <p data-pat-status role="status" data-state="idle">Introduce y guarda tu token de GitHub para habilitar el guardado.</p>
  </div>
  <p data-editor-status role="status"></p>
  <div class="editor-panels">
    <div class="editor-source">
      <label for="wiki-markdown">Markdown</label>
      <textarea id="wiki-markdown" spellcheck="false" maxlength="120000">{example}</textarea>
    </div>
    <section class="editor-preview" aria-label="Resultado en directo">
      <p class="editor-label" aria-hidden="true">Resultado</p>
      <div data-editor-result></div>
    </section>
  </div>
  <noscript><p>Activa JavaScript para usar la vista previa y guardar borradores en este navegador.</p></noscript>
</div>
<script>
  import { installWikiEditor } from '../lib/wiki-editor.mjs';
  document.querySelectorAll('[data-wiki-editor]').forEach(installWikiEditor);
</script>
<style>
  .editor-toolbar, .editor-views { display: flex; flex-wrap: wrap; gap: .5rem; }
  .editor-views { display: none; }
  .editor-pat { margin-block: .5rem; align-items: center; }
  .editor-pat label { border: 0; padding: 0; }
  .editor-pat input { min-width: 12rem; max-width: 100%; flex: 1; padding: .5rem; font: inherit; }
  [data-pat-status] { flex-basis: 100%; margin: 0; padding: .5rem .75rem; border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; }
  [data-pat-status][data-state='success'] { color: var(--sl-color-green-high, #237a42); border-color: currentColor; }
  [data-pat-status][data-state='error'] { color: var(--sl-color-red-high, #b42318); border-color: currentColor; }
  button:disabled { opacity: .55; cursor: not-allowed; }
  button { color: var(--sl-color-white); background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; padding: .5rem .75rem; font: inherit; cursor: pointer; }
  button[data-editor-save], button[aria-pressed='true'] { background: var(--sl-color-accent-low); }
  [data-editor-status] { min-block-size: 1.5em; }
  .editor-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--sl-color-gray-5); border-radius: .6rem; }
  .editor-source, .editor-preview { min-inline-size: 0; margin: 0; }
  .editor-source { border-inline-end: 1px solid var(--sl-color-gray-5); }
  label, .editor-label { display: block; margin: 0; padding: .55rem .75rem; font-weight: 600; border-block-end: 1px solid var(--sl-color-gray-5); }
  textarea, [data-editor-result] { inline-size: 100%; min-block-size: 22rem; block-size: min(62vh, 36rem); overflow: auto; margin: 0; padding: .8rem; }
  textarea { display: block; resize: vertical; border: 0; background: var(--sl-color-gray-7, var(--sl-color-black)); color: var(--sl-color-white); font: inherit; font-family: var(--sl-font-mono); }
  [data-editor-result] { overflow-wrap: anywhere; }
  [data-editor-result] :global(img) { max-inline-size: 100%; }
  @media (max-width: 65rem) {
    .editor-views { display: flex; flex-basis: 100%; }
    .editor-panels { grid-template-columns: minmax(0, 1fr); }
    .editor-source { border-inline-end: 0; }
    [data-active-view='edit'] .editor-preview, [data-active-view='result'] .editor-source { display: none; }
  }
</style>
