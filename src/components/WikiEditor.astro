---
import '../../examples/astro-component-lab/src/components/tree-table.css';
const settingsUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/configuracion/`;
interface Props { path: string; source: string; title: string; documentId: string; examples?: string; }
const { path, source, title, documentId, examples = '' } = Astro.props;
const language = path.endsWith('.mdx') ? 'MDX' : 'Markdown';
const historyUrl = `https://github.com/PabloGonzalezRuiz/AstroXmind/commits/main/${path.split('/').map(encodeURIComponent).join('/')}`;
---
<div class="wiki-editor" data-wiki-editor data-source-path={path} data-document-id={documentId} data-pagefind-ignore data-active-view="split">
  {examples && <template data-editor-examples={examples}></template>}
  <div class="reader-toolbar">
    <span class="reader-caption">Página actual</span>
    <details class="page-actions" data-page-actions>
      <summary aria-label="Acciones del documento">Acciones ▾</summary>
      <div class="action-menu">
        <button type="button" data-editor-open>Editar documento</button>
        <button type="button" data-editor-source-open>Ver código fuente</button>
        <button type="button" data-history-open>Historial de versiones</button>
        <a href={historyUrl}>Historial en GitHub</a>
      </div>
    </details>
  </div>
  <p data-page-save-status role="status" hidden></p>
  <dialog class="editor-workspace" data-editor-workspace aria-labelledby="editor-workspace-title">
    <div class="workspace-head">
      <div><p class="workspace-brand">AstroXmind</p><h2 id="editor-workspace-title">{title}</h2></div>
      <div class="editor-toolbar" data-editor-pat>
        <button type="button" class="primary-save" data-pat-save disabled>Guardar</button>
        <button type="button" data-pat-load hidden>Recuperar revisión</button>
        <a href={settingsUrl}>Configuración</a>
        <a data-pat-result hidden>Ver commit en GitHub</a>
      </div>
      <button type="button" data-editor-close aria-label="Cerrar edición">Cerrar ×</button>
    </div>
    <p data-pat-status role="status" data-state="idle">Configura la conexión con GitHub para habilitar el guardado.</p>
    <div class="workspace-tools">
      <div class="editor-toolbar" role="group" aria-label="Formato Markdown">
        <button type="button" data-editor-format="bold" title="Negrita" aria-label="Negrita"><strong>B</strong></button>
        <button type="button" data-editor-format="italic" title="Cursiva" aria-label="Cursiva"><em>I</em></button>
        <button type="button" data-editor-format="heading" title="Encabezado" aria-label="Encabezado">H2</button>
        <button type="button" data-editor-format="list" title="Lista con viñetas" aria-label="Lista con viñetas">• Lista</button>
        <button type="button" data-editor-format="ordered" title="Lista numerada" aria-label="Lista numerada">1. Lista</button>
        <button type="button" data-editor-format="code" title="Código" aria-label="Código">&lt;/&gt;</button>
        <button type="button" data-editor-format="link" title="Enlace" aria-label="Enlace">Enlace</button>
        <div class="editor-create" data-editor-create>
          <button type="button" data-create-toggle aria-expanded="false" aria-controls="editor-create-options" title="Crear un componente desde una selección (Mayús+F10)">Crear ▾</button>
          <div id="editor-create-options" data-create-panel role="group" aria-label="Crear componente" hidden>
            <strong>Crear desde la selección</strong>
            <div data-create-options></div>
            <button type="button" data-create-close>Cerrar menú</button>
          </div>
        </div>
      </div>
      <div class="editor-views" role="group" aria-label="Modo de edición">
        <button type="button" data-editor-sync aria-pressed="true" title="Vincular código y resultado al hacer clic, mover el cursor o desplazarse">🔗 Sincronizar paneles</button>
        <button type="button" data-editor-view="edit" aria-pressed="false">Markdown</button>
        <button type="button" data-editor-view="split" aria-pressed="true">Dividido</button>
        <button type="button" data-editor-view="result" aria-pressed="false">Resultado</button>
      </div>
    </div>
    <div class="editor-panels">
      <div class="editor-source">
        <label for="wiki-markdown">{language} <small id="editor-keyboard-help">Tab: +2 espacios · Mayús+Tab: −2 · Enter: continuar lista · Esc, Tab: navegar · Mayús+F10: crear</small></label>
        <textarea id="wiki-markdown" aria-describedby="editor-keyboard-help" spellcheck="false" maxlength="120000">{source}</textarea>
      </div>
      <section class="editor-preview" aria-label="Resultado en directo">
        <p class="editor-label" aria-hidden="true">Resultado {language}</p>
        <div data-editor-result></div>
      </section>
    </div>
    <div class="workspace-footer editor-toolbar">
      <button type="button" data-editor-download disabled>Descargar Markdown</button>
      <p data-editor-status role="status"></p>
    </div>
  </dialog>
  <dialog class="source-dialog" data-source-dialog aria-labelledby="source-title">
    <div class="reader-toolbar"><h2 id="source-title">Código Markdown</h2><button type="button" data-source-close>Cerrar ×</button></div>
    <pre><code data-editor-source-content></code></pre>
  </dialog>
  <dialog class="source-dialog" data-history-dialog aria-labelledby="history-title">
    <div class="reader-toolbar"><h2 id="history-title">Historial de versiones</h2><button type="button" data-history-close>Cerrar ×</button></div>
    <p data-history-status role="status"></p>
    <ol data-history-list></ol>
    <button type="button" data-history-more hidden>Mostrar versiones anteriores</button>
    <p><a href={historyUrl}>Ver historial completo en GitHub</a></p>
    <h3 data-history-preview-title hidden></h3>
    <pre data-history-preview hidden></pre>
  </dialog>
  <noscript><p>Activa JavaScript para editar la página.</p></noscript>
</div>
<script>
  import '../../examples/astro-component-lab/src/components/tree-table-client';
  import { installWikiEditor } from '../lib/wiki-editor.mjs';
  document.querySelectorAll('[data-wiki-editor]').forEach(installWikiEditor);
</script>
<style>
  .editor-toolbar, .editor-views { display: flex; flex-wrap: wrap; gap: .5rem; }
  .reader-toolbar { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .reader-caption { font-size: .875rem; color: var(--sl-color-gray-2); }
  .page-actions { position: relative; margin: 0; }
  .page-actions summary { cursor: pointer; border: 1px solid var(--sl-color-gray-4); border-radius: .45rem; padding: .45rem .7rem; list-style: none; }
  .action-menu { position: absolute; inset-inline-end: 0; z-index: 5; min-width: 13rem; display: grid; gap: .25rem; padding: .4rem; background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; box-shadow: 0 8px 24px #0003; }
  .action-menu button, .action-menu a { text-align: start; margin: 0; padding: .5rem .7rem; }
  [data-page-save-status]:not([hidden]) { padding: .6rem .8rem; margin-block: .5rem; border: 1px solid var(--sl-color-green-high, #237a42); color: var(--sl-color-green-high, #237a42); border-radius: .4rem; overflow-wrap: anywhere; }
  .editor-workspace { position: fixed; inset: 0; margin: 0; width: 100%; max-width: 100%; height: 100dvh; max-height: 100dvh; padding: 0; border: 0; color: var(--sl-color-text); background: var(--sl-color-bg); }
  .editor-workspace[open] { display: flex; flex-direction: column; }
  dialog::backdrop { background: #0008; }
  .workspace-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1.2rem; border-bottom: 1px solid var(--sl-color-gray-5); }
  .workspace-head h2 { font-size: 1.05rem; margin: 0; }
  .workspace-brand { color: var(--sl-color-text-accent); font-size: .75rem; margin: 0; font-weight: 700; }
  .workspace-head .editor-toolbar { align-items: center; justify-content: flex-end; margin: 0; }
  .workspace-tools { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; padding: .55rem 1rem; background: var(--sl-color-gray-6); border-bottom: 1px solid var(--sl-color-gray-5); }
  .workspace-tools button { padding: .35rem .6rem; }
  .editor-create { position: relative; }
  [data-create-toggle][data-selection='true'] { border-color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
  [data-create-panel]:not([hidden]) { position: absolute; inset-block-start: calc(100% + .35rem); inset-inline-start: 0; z-index: 20; width: min(22rem, 85vw); max-height: 55dvh; overflow: auto; display: grid; gap: .65rem; padding: .8rem; border: 1px solid var(--sl-color-gray-4); border-radius: .5rem; background: var(--sl-color-bg); box-shadow: 0 .5rem 1.5rem #0004; }
  [data-create-options] :global(p) { font-size: .85rem; margin: .25rem 0 .65rem; }
  @media (max-width: 700px) { [data-create-panel]:not([hidden]) { position: fixed; inset: auto 1rem 1rem; width: auto; } }
  .workspace-footer { align-items: center; padding: .55rem 1rem; border-top: 1px solid var(--sl-color-gray-5); }
  .workspace-footer p { margin: 0; font-size: .85rem; }
  .source-dialog { background: var(--sl-color-bg); color: var(--sl-color-text); border: 1px solid var(--sl-color-gray-4); border-radius: .6rem; padding: 1rem; width: min(56rem, 90vw); max-height: 85dvh; }
  [data-history-list] { padding-inline-start: 1.5rem; }
  [data-history-list] :global(li) { margin-block: .75rem; overflow-wrap: anywhere; }
  [data-history-list] :global(button) { margin-inline-end: .75rem; }
  [data-history-status][data-state='error'] { color: var(--sl-color-red-high, #b42318); }
  .source-dialog pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 65dvh; overflow: auto; }
  [data-pat-status] { margin: .5rem 1rem; padding: .5rem .75rem; border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; overflow-wrap: anywhere; }
  [data-pat-status][data-state='success'] { color: var(--sl-color-green-high, #237a42); border-color: currentColor; }
  [data-pat-status][data-state='error'] { color: var(--sl-color-red-high, #b42318); border-color: currentColor; }
  button:disabled { opacity: .55; cursor: not-allowed; }
  button { color: var(--sl-color-white); background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; padding: .5rem .75rem; font: inherit; cursor: pointer; }
  button[data-editor-save], button[aria-pressed='true'], .primary-save { background: var(--sl-color-accent-low); }
  [data-editor-status] { min-block-size: 1.5em; }
  .editor-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: 0; flex: 1; margin: 0; }
  .editor-source, .editor-preview { display: flex; flex-direction: column; min-inline-size: 0; min-height: 0; margin: 0; }
  .editor-source { border-inline-end: 1px solid var(--sl-color-gray-5); }
  label, .editor-label { display: block; margin: 0; padding: .55rem .75rem; font-weight: 600; border-block-end: 1px solid var(--sl-color-gray-5); }
  #editor-keyboard-help { font-size: .72rem; font-weight: 400; color: var(--sl-color-gray-3); margin-inline-start: .4rem; }
  textarea, [data-editor-result] { inline-size: 100%; min-block-size: 0; flex: 1; overflow: auto; margin: 0; padding: 1rem; }
  textarea { display: block; resize: none; border: 0; background: var(--sl-color-gray-7, var(--sl-color-black)); color: var(--sl-color-white); font: inherit; font-family: var(--sl-font-mono, ui-monospace, monospace); }
  [data-editor-result] { overflow-wrap: anywhere; }
  [data-editor-result] :global(img) { max-inline-size: 100%; }
  [data-editor-result] :global(.editor-mdx-warning) { border: 1px solid var(--sl-color-gray-4); padding: .75rem; border-radius: .4rem; }
  [data-editor-result] :global(.editor-source-highlight) { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; border-radius: .15rem; }
  [data-active-view='edit'] .editor-preview, [data-active-view='result'] .editor-source { display: none; }
  [data-active-view='edit'] .editor-panels, [data-active-view='result'] .editor-panels { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 42rem) {
    .workspace-head { flex-wrap: wrap; padding: .5rem; gap: .5rem; }
    .workspace-tools { padding: .4rem; }
    .editor-panels { grid-template-columns: minmax(0, 1fr); }
    .editor-source { border-inline-end: 0; }
    [data-active-view='split'] .editor-panels { grid-template-rows: repeat(2, minmax(0, 1fr)); }
  }
</style>
