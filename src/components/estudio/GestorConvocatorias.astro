<section id="gestor-convocatorias">
  <p>Arrastra una convocatoria oficial en PDF. Se identificará por su contenido y se conservará intacta. Los archivos se guardan en este navegador, no se publican ni se sincronizan con otros dispositivos. Descárgalos para conservar una copia externa.</p>
  <label class="drop" id="conv-drop">Añadir convocatoria <input id="conv-file" type="file" accept="application/pdf,.pdf" multiple /></label>
  <p id="conv-status" role="status" aria-live="polite">Preparando archivo local…</p>
  <h2>PDF incorporados</h2>
  <div class="table-wrap"><table><thead><tr><th>PDF y nombre normalizado</th><th>Metadatos y comprobación</th><th>Expediente</th></tr></thead><tbody id="conv-list"></tbody></table></div>
  <section id="conv-detail" hidden aria-label="Expediente seleccionado"></section>
</section>
<style>
  .drop { display:grid; gap:.75rem; border:2px dashed var(--sl-color-accent); border-radius:.6rem; padding:1.4rem; font-weight:700; }
  .table-wrap {overflow-x:auto} th,td{vertical-align:top;overflow-wrap:anywhere;min-width:10rem} td:first-child{min-width:12rem} #conv-detail{border:1px solid var(--sl-color-gray-5);padding:1rem;border-radius:.6rem;margin-top:1rem} :global(.conv-meta){border:1px solid var(--sl-color-gray-4);border-radius:.5rem;padding:1rem;margin:1rem 0} :global(.conv-text){white-space:pre-wrap;max-height:65vh;overflow:auto;font-size:.85rem} :global(.conv-actions){display:flex;flex-wrap:wrap;gap:1rem} :global(.conv-filename){overflow-wrap:anywhere} :global(.conv-button){padding:.4rem .7rem;cursor:pointer} :global(.conv-status){font-weight:bold}
</style>
<script>
  import { getDocument, GlobalWorkerOptions } from 'pdfjs-dist';
  import workerURL from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { identify, markdown, pageText } from '../../lib/convocatorias.mjs';
  GlobalWorkerOptions.workerSrc = workerURL;
  const input=document.querySelector<HTMLInputElement>('#conv-file')!;
  const drop=document.querySelector<HTMLElement>('#conv-drop')!;
  const status=document.querySelector<HTMLElement>('#conv-status')!;
  const list=document.querySelector<HTMLElement>('#conv-list')!;
  const detail=document.querySelector<HTMLElement>('#conv-detail')!;
  const open = new Promise<IDBDatabase>((resolve,reject)=>{const req=indexedDB.open('astroxmind-convocatorias',1);req.onupgradeneeded=()=>req.result.createObjectStore('expedientes',{keyPath:'sha256'});req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});
  type RecordData={sha256:string; original:string; pdf:Blob; meta:any; md:string; error?:string};
  async function records():Promise<RecordData[]>{const db=await open;return new Promise((resolve,reject)=>{const r=db.transaction('expedientes').objectStore('expedientes').getAll();r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);});}
  async function save(record:RecordData){const db=await open;return new Promise<void>((resolve,reject)=>{const t=db.transaction('expedientes','readwrite');t.objectStore('expedientes').add(record);t.oncomplete=()=>resolve();t.onerror=()=>reject(t.error);});}
  const el=(tag:string, text='', cls='')=>{const e=document.createElement(tag);e.textContent=text;if(cls)e.className=cls;return e;};
  let urls:string[]=[];
  function link(blob:Blob,name:string,label:string,download=true){const a=document.createElement('a');const u=URL.createObjectURL(blob);urls.push(u);a.href=u;a.textContent=label;if(download)a.download=name;else{a.target='_blank';a.rel='noopener';}return a;}
  function fileLinks(r:RecordData){const p=el('div','','conv-actions');p.append(link(r.pdf,r.original,'Ver PDF recibido',false),link(r.pdf,r.original,'Descargar original'));if(r.meta){const id=r.meta.identidad;p.append(link(r.pdf,id+'__F00-ORIGINAL.pdf','PDF normalizado'),link(new Blob([r.md],{type:'text/markdown;charset=utf-8'}),id+'__F01-TRANSCRIPCION.md','Descargar Markdown'),link(new Blob([JSON.stringify(r.meta,null,2)],{type:'text/yaml;charset=utf-8'}),id+'__METADATOS.yaml','Descargar YAML'));}return p;}
  function show(r:RecordData){detail.hidden=false;detail.replaceChildren(el('h2',r.meta?.identidad||r.original),fileLinks(r));if(!r.meta){detail.append(el('p',r.error||'Pendiente de revisión'));return;}const box=el('details','','conv-meta') as HTMLDetailsElement;box.open=true;box.append(el('summary','Metadatos del documento'),el('p',`${r.meta.fecha_publicacion} · ${r.meta.referencia} · ${r.meta.cuerpo} / ${r.meta.modalidad} · ${r.meta.paginas} páginas`),el('pre',JSON.stringify(r.meta,null,2),'conv-text'));detail.append(box,el('h3','F01 · Markdown generado'),el('pre',r.md,'conv-text'));detail.scrollIntoView({behavior:'smooth',block:'start'});}
  async function render(){const all=await records();list.replaceChildren();for(const r of all){const tr=el('tr');const name=el('td');name.append(el('strong',r.original,'conv-filename'),el('p',r.meta?r.meta.identidad+'__F00-ORIGINAL.pdf':'Sin renombrar','conv-filename'));const meta=el('td');meta.append(el('p',r.meta?'Identificado · comprobación externa pendiente':'Pendiente de revisión','conv-status'),el('p',r.meta?`${r.meta.fecha_publicacion} · ${r.meta.referencia}\n${r.meta.cuerpo} / ${r.meta.modalidad} · ${r.meta.paginas} páginas`:r.error));const actions=el('td');const button=el('button','Abrir expediente','conv-button');button.addEventListener('click',()=>show(r));actions.append(button);tr.append(name,meta,actions);list.append(tr);}if(!all.length){const tr=el('tr');const td=el('td','Todavía no hay PDF incorporados.');td.setAttribute('colspan','3');tr.append(td);list.append(tr);}}
  let busy=false;
  async function ingest(files:File[]){if(busy)return;busy=true;input.disabled=true;try{for(const file of files){if(file.size>40*1024*1024){status.textContent='Límite de 40 MB por PDF: '+file.name;continue;}status.textContent='Analizando '+file.name;const bytes=await file.arrayBuffer();const sha256=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes)),b=>b.toString(16).padStart(2,'0')).join('');const all=await records();if(all.some(r=>r.sha256===sha256)){status.textContent='Ya incorporado: '+file.name;continue;}const record:RecordData={sha256,original:file.name,pdf:new Blob([bytes],{type:'application/pdf'}),meta:null,md:''};let doc;try{doc=await getDocument({data:new Uint8Array(bytes),isEvalSupported:false}).promise;const pages:string[]=[];const metadata=await doc.getMetadata();for(let i=1;i<=doc.numPages;i++){status.textContent=`Leyendo ${file.name}: página ${i}/${doc.numPages}`;pages.push(pageText((await (await doc.getPage(i)).getTextContent()).items));}const id=identify(pages,metadata.info);if(all.some(r=>r.meta?.identidad===id.identidad))throw new Error('Misma identidad, diferente huella. Revisión necesaria.');record.meta={...id,nombre_recibido:file.name,sha256,paginas:pages.length,fase:'F01',inmutable:true,indexar_fuente:false,limitaciones:['Texto extraído sin OCR ni comprobación visual de tablas']};record.md=markdown(record.meta,pages);}catch(e){record.error=e instanceof Error?e.message:String(e);}finally{await doc?.destroy();}await save(record);await render();status.textContent=record.meta?'Identificado y guardado: '+file.name:'Conservado para revisión: '+file.name;}}catch(e){status.textContent='No se pudo guardar: '+String(e);}finally{busy=false;input.disabled=false;input.value='';}}
  input.addEventListener('change',()=>void ingest(Array.from(input.files||[])));drop.addEventListener('dragover',e=>e.preventDefault());drop.addEventListener('drop',e=>{e.preventDefault();void ingest(Array.from(e.dataTransfer?.files||[]));});
  render().then(()=>{status.textContent='Listo para añadir convocatorias.';}).catch(e=>{status.textContent='Archivo local no disponible: '+String(e);input.disabled=true;});
  window.addEventListener('pagehide',()=>{for(const u of urls)URL.revokeObjectURL(u);urls=[];});
</script>
