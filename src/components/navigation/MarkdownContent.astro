---
import DefaultMarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
import WikiEditor from '../WikiEditor.astro';
import { resolveRenderedReferences } from '../../lib/navigation/rendered-references.mjs';
const html = await Astro.slots.render('default');
const context = Astro.locals.documentNavigation;
const resolvedHtml = context ? resolveRenderedReferences(html, context.index) : html;
const sources = import.meta.glob<string>('/src/content/docs/**/*.{md,mdx}', { query: '?raw', import: 'default', eager: true });
const path = Astro.locals.starlightRoute.entry.filePath;
const source = path ? sources[`/${path.replace(/^\/+/, '')}`] : undefined;
---
{context && path && source !== undefined && <WikiEditor path={path} source={source} title={context.current.title} documentId={context.current.id} />}
<DefaultMarkdownContent><Fragment set:html={resolvedHtml} /></DefaultMarkdownContent>
