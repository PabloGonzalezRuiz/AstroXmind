---
import NavigationLabel from './NavigationLabel.astro';
const context = Astro.locals.documentNavigation;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{context && <nav aria-label="Ruta de ubicación" class="breadcrumbs" data-pagefind-ignore>
  <a href={context.current.url} data-reading-return hidden>← Volver al punto de lectura</a>
  <ol>{context.breadcrumbs.map((node) => <li>
    {node.id === context.current.id
      ? <span aria-current="page"><NavigationLabel {node} /></span>
      : <a href={node.url}><NavigationLabel {node} /></a>}
  </li>)}</ol>
  {context.parent && <a class="parent" href={context.parent.url}>↑ Subir a <NavigationLabel node={context.parent} /></a>}
  <a class="export" href={`${base}/rama/${context.current.id}.html`}>Imprimir o descargar esta rama</a>
</nav>}
<style>
  .breadcrumbs { font-size: var(--sl-text-sm); margin-bottom: 1rem; overflow-wrap: anywhere; }
  ol { display: flex; flex-wrap: wrap; gap: .35rem .6rem; padding: 0; list-style: none; }
  li + li::before { content: '/'; margin-inline-end: .6rem; color: var(--sl-color-gray-3); }
  [aria-current] { color: var(--sl-color-gray-2); }
  .parent, .export { display: inline-block; margin-top: .5rem; }
  .export { margin-inline-start: .75rem; }
  @media print { .parent, .export { display: none; } }
</style>
