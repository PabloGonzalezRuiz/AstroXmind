<dialog id="study-note-dialog" aria-labelledby="study-note-heading" data-reading-ignore>
  <h2 id="study-note-heading">Nota manuscrita</h2>
  <p data-note-text></p>
  <form method="dialog"><button>Cerrar</button></form>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#study-note-dialog');
  if (dialog) {
    let trigger: HTMLButtonElement | null = null;
    document.addEventListener('click', event => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>('button[data-study-note]');
      if (!button) return;
      trigger = button;
      const text = dialog.querySelector('[data-note-text]');
      if (text) text.textContent = button.dataset.studyNote ?? '';
      button.setAttribute('aria-expanded', 'true');
      dialog.showModal();
    });
    dialog.addEventListener('close', () => { trigger?.setAttribute('aria-expanded', 'false'); trigger?.focus(); });
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  }
</script>
<style is:global>
  .study-pink { background: #f4abb5; color: #241318; }
  .study-purple { background: #cba5ef; color: #20122e; }
  .study-pink, .study-purple { border-radius: .12em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .study-pen { text-decoration: underline; text-decoration-thickness: .1em; text-underline-offset: .18em; }
  .study-circle { outline: 1.5px solid currentColor; border-radius: .75em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  button.study-note { display: inline-flex; vertical-align: super; align-items: center; justify-content: center; width: 1.65rem; height: 1.65rem; border: 0; background: transparent; color: var(--sl-color-text-accent); cursor: pointer; padding: 0; margin: 0 .12rem; }
  #study-note-dialog { max-width: min(28rem, calc(100vw - 2rem)); width: 100%; background: var(--sl-color-bg); color: var(--sl-color-text); border: 1px solid var(--sl-color-gray-4); border-radius: .8rem; padding: 1.2rem; margin: auto; }
  #study-note-dialog::backdrop { background: #0008; }
  #study-note-dialog h2 { font-size: 1.15rem; margin: 0 0 .6rem; }
  #study-note-dialog p { margin-bottom: 1rem; }
  #study-note-dialog button { padding: .5rem .9rem; color: var(--sl-color-text); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; }
</style>
