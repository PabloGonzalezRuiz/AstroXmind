---
import TreeBranch from './navigation/TreeBranch.astro';
interface Props { showTree?: boolean; }
const { showTree = true } = Astro.props;
const context = Astro.locals.documentNavigation;
const siblings = context?.parent ? context.parent.children.map(id => context.index.nodes[id]) : [];
---
{context && <section class="document-navigation" aria-label="Navegación del documento" data-document-navigator data-pagefind-ignore>
  <p class="location"><strong>Estás en:</strong> {context.current.title}</p>
  {context.parent && <p><a href={context.parent.url} rel="up">↑ Subir a {context.parent.title}</a></p>}
  {siblings.length > 1 && <nav aria-label="Documentos hermanos" class="siblings">
    <h2>En este nivel</h2>
    <ul>{siblings.map(node => <li>{node.id === context.current.id
      ? <span aria-current="page">{node.title}</span>
      : <a href={node.url}>{node.title}</a>}</li>)}</ul>
  </nav>}
  {showTree && <details open class="tree"><summary>Árbol completo · ubicación actual</summary>
    <nav aria-label="Árbol del documento"><ul><TreeBranch index={context.index} id={context.index.rootId} currentId={context.current.id} /></ul></nav>
  </details>}
  {context.children.length > 0 && <nav aria-label="Documentos hijos" class="children">
    <h2>Dentro de este documento</h2>
    <ul>{context.children.map(node => <li><a href={node.url}>{node.title}</a></li>)}</ul>
  </nav>}
  {(context.previous || context.next) && <nav aria-label="Recorrido de lectura" class="reading print:hidden">
    {context.previous && <a href={context.previous.url} rel="prev"><small>← Anterior</small><span>{context.previous.title}</span></a>}
    {context.next && <a href={context.next.url} rel="next"><small>Siguiente →</small><span>{context.next.title}</span></a>}
  </nav>}
</section>}
<style>
  .document-navigation { border: 1px solid var(--sl-color-hairline); border-radius: .6rem; padding: 1rem; }
  .location { margin-bottom: .5rem; }
  .siblings, .tree { margin-block: 1rem; }
  .siblings [aria-current] { font-weight: 600; }
  .tree summary { cursor: pointer; font-weight: 600; }
  .tree ul { padding-inline-start: 0; }
  .children { border-top: 1px solid var(--sl-color-hairline); padding-top: 1rem; margin-bottom: 1.5rem; }
  h2 { font-size: var(--sl-text-lg); font-weight: 600; }
  ul { padding-inline-start: 1.25rem; margin-top: .5rem; }
  li { margin-block: .4rem; }
  .reading { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .reading a { display: flex; flex-direction: column; gap: .4rem; padding: 1rem; border: 1px solid var(--sl-color-hairline); border-radius: .5rem; text-decoration: none; overflow-wrap: anywhere; }
  .reading a:hover { border-color: var(--sl-color-text-accent); }
  [rel='next'] { grid-column: 2; text-align: end; }
  @media (max-width: 30rem) { .reading { grid-template-columns: 1fr; } [rel='next'] { grid-column: 1; } }
</style>
