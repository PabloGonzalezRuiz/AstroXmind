---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { reglasIniciales, mdInicial, plantillas } from '../lib/editor-v2.mjs';
---
<StarlightPage frontmatter={{title:'Editor de temario de convocatoria',template:'splash',pagefind:false,editUrl:false}}>
  <div class="editor-v2">
    <p>Define los tipos y sus propiedades. En el Markdown, asigna el tipo mediante corchetes y sobrescribe cualquier propiedad del tipo.</p>
    <div class="barra" role="group" aria-label="Acciones del editor"><button type="button" data-copiar>Copiar Markdown con IDs</button><button type="button" data-exportar>Exportar borrador</button><button type="button" data-restaurar>Restablecer ejemplo</button><a href={import.meta.env.BASE_URL.replace(/\/$/,'')+'/editor-programa/'}>Editor anterior</a></div>
    <div class="paneles">
      <section class="panel-editor"><label class="titulo-panel" for="v2-reglas">1. Definición de niveles y estilos</label><div class="acciones-panel" role="group" aria-label="Plantilla de estilos"><label for="v2-plantilla">Plantilla</label> <select id="v2-plantilla">{plantillas.map(p=><option value={p.id}>{p.nombre}</option>)}</select> <button type="button" data-plantilla> Cargar plantilla </button></div><textarea id="v2-reglas" spellcheck="false" rows="16">{reglasIniciales}</textarea></section>
      <section class="panel-editor"><label class="titulo-panel" for="v2-md">2. Markdown con tipos</label><div class="acciones-panel" role="group" aria-label="Acciones del Markdown"><button type="button" data-tipos>Asignar tipos por profundidad</button><button type="button" data-ids>Asignar IDs pendientes</button></div><textarea id="v2-md" spellcheck="false" rows="16">{mdInicial}</textarea></section>
      <section><h2>3. Resultado en directo</h2><p data-estado role="status" aria-live="polite"></p><div data-resultado></div></section>
    </div>
    <details><summary>Numeración gradual y sobrescrituras</summary><p><code>heredar=0</code>: propia; <code>heredar=1</code>: último ancestro numerado; <code>heredar=2</code>: dos ancestros; <code>heredar=todo</code>: todos. Los niveles sin número no cuentan. <code>separador=.</code> es el valor predeterminado.</p><p>Ejemplo: <code>Nombre tema[Tema prefijo=X heredar=0 ancho=3]</code>. Tab y Mayús+Tab cambian la sangría. La jerarquía del contenido se expresa por sangría; puede omitir tipos de la definición.</p><p>La convocatoria reúne oposición, modalidad y año en una sola línea (TAI.LBR.2025). Sobrescribe los metadatos, por ejemplo [Convocatoria oposicion=TAI modalidad=LBR año=2026]. La clasificación inicial usa Convocatoria → Bloque → Tema → Apartado. Conserva tipos explícitos; niveles adicionales se escriben a mano. Laboratorio ficticio: exporta localmente reglas y contenido. No modifica expedientes ni GitHub. Conserva los IDs al copiar o exportar Markdown; no los borres al editar. Los nuevos nodos reciben ID al asignar, copiar o exportar.</p></details>
  </div>
</StarlightPage>
<script>
  import { proyectar, reglasIniciales, mdInicial, plantillas, completarIds, clasificarPorProfundidad, cabecerasConvocatoria } from '../lib/editor-v2.mjs';
  import { installEditorKeys } from '../lib/wiki-editor-keys.mjs';
  const root=document.querySelector('.editor-v2');
  if(root){
    const reglas=root.querySelector<HTMLTextAreaElement>('#v2-reglas')!;
    const md=root.querySelector<HTMLTextAreaElement>('#v2-md')!;
    const resultado=root.querySelector<HTMLElement>('[data-resultado]')!;
    const estado=root.querySelector<HTMLElement>('[data-estado]')!;
    const copiar=root.querySelector<HTMLButtonElement>('[data-copiar]')!;
    const exportar=root.querySelector<HTMLButtonElement>('[data-exportar]')!;
    installEditorKeys(reglas);installEditorKeys(md);
    const asignar=()=>{md.value=completarIds(reglas.value,md.value);};
    const render=()=>{
      resultado.replaceChildren();
      try{
        const nodos=proyectar(reglas.value,md.value);
        const cabeceras=cabecerasConvocatoria(nodos);
        for(const n of nodos){
          const fila=document.createElement('div');
          fila.style.paddingInlineStart=(n.nivel*1.1)+'rem';
          const propias=cabeceras.filter(c=>c.oposicionFila===n.fila);
          const cabecera=propias.length===1?propias[0].texto:propias.length>1?null:cabeceras.find(c=>c.modalidadFila===n.fila&&cabeceras.filter(x=>x.oposicionFila===c.oposicionFila).length>1)?.texto;
          const codigo=document.createElement('strong');codigo.textContent=!cabecera&&n.codigo ? n.codigo+' · ' : '';
          const titulo=document.createElement('span');titulo.textContent=cabecera||n.titulo;if(cabecera){titulo.title=n.titulo;titulo.style.fontWeight='bold';}
          const tipo=document.createElement('small');tipo.textContent=' ['+n.tipo+']'+(n.id?' [id='+n.id+']':' [ID pendiente]');
          fila.append(codigo,titulo,tipo);resultado.append(fila);
        }
        estado.textContent=nodos.length+' nodos · Vista válida';
        copiar.disabled=exportar.disabled=false;
      }catch(e){estado.textContent=e instanceof Error?e.message:String(e);copiar.disabled=exportar.disabled=true;}
    };
    reglas.addEventListener('input',render);md.addEventListener('input',render);
    root.querySelector('[data-ids]')?.addEventListener('click',()=>{try{asignar();render();}catch(e){estado.textContent=String(e);}});
    const selector=root.querySelector<HTMLSelectElement>('#v2-plantilla')!;
    root.querySelector('[data-tipos]')?.addEventListener('click',()=>{try{const perfil=plantillas.find(p=>p.id===selector.value)?.importacion;md.value=clasificarPorProfundidad(reglas.value,md.value,perfil);render();}catch(e){estado.textContent=String(e);}});
    root.querySelector('[data-plantilla]')?.addEventListener('click',()=>{const p=plantillas.find(p=>p.id===selector.value);if(p&&confirm('¿Cargar los estilos de esta plantilla? El Markdown se conservará.')){reglas.value=p.reglas;render();}});
    copiar.addEventListener('click',async()=>{
      try{asignar();render();await navigator.clipboard.writeText(md.value);estado.textContent='Resultado copiado.';}catch{estado.textContent='No se pudo copiar.';}
    });
    exportar.addEventListener('click',()=>{
      try{asignar();render();}catch(e){estado.textContent=String(e);return;}
      const blob=new Blob([JSON.stringify({version:3,plantilla:selector.value,reglas:reglas.value,markdown:md.value},null,2)],{type:'application/json'});
      const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='editor-temario-convocatoria.json';a.click();URL.revokeObjectURL(url);
    });
    root.querySelector('[data-restaurar]')?.addEventListener('click',()=>{if(confirm('¿Restablecer el ejemplo y descartar cambios?')){reglas.value=reglasIniciales;md.value=mdInicial;asignar();render();}});
    render();
  }
</script>
<style>
  .paneles{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem}
  .paneles section{min-width:0}
  .paneles section:last-child{grid-column:1/-1}
  textarea{display:block;width:100%;min-height:16rem;resize:vertical;white-space:pre;overflow:auto;tab-size:2;padding:.8rem;background:#fff;color:#111;border:1px solid #8d98a5;border-left:3px solid #f09332;border-radius:.25rem;font:1rem/1.6 'Consolas','Courier New',monospace}
  .editor-v2 .panel-editor{display:flex;flex-direction:column;gap:.6rem;margin:0}
  .editor-v2 .titulo-panel{display:block;font-weight:650;margin:0;line-height:1.5;min-height:1.5rem}
  .editor-v2 .barra,.editor-v2 .acciones-panel{display:flex;align-items:center;gap:.45rem;flex-wrap:wrap}
  .editor-v2 .barra{margin-block:.85rem}
  .editor-v2 .acciones-panel{min-height:2rem;margin:0}
  .editor-v2 .barra > *, .editor-v2 .acciones-panel > *, .editor-v2 .panel-editor > textarea{margin:0!important}
  .editor-v2 .barra a,.editor-v2 .acciones-panel label{font-size:.875rem}
  .editor-v2 button,.editor-v2 select{box-sizing:border-box;font:inherit;font-size:.875rem;line-height:1.25;min-height:2rem;border-radius:.3rem}
  .editor-v2 button{display:inline-flex;align-items:center;justify-content:center;padding:.3rem .55rem;border:1px solid var(--sl-color-accent);background:var(--sl-color-accent-low);color:var(--sl-color-white);cursor:pointer;text-align:center}
  .editor-v2 select{max-width:100%;padding:.2rem .35rem}
  .editor-v2 button:focus-visible,.editor-v2 select:focus-visible{outline:2px solid var(--sl-color-accent);outline-offset:2px}
  button:disabled{opacity:.45;cursor:default}
  [data-resultado]{border:1px solid var(--sl-color-gray-4);border-radius:.3rem;padding:.8rem;overflow:auto}
  [data-resultado] :global(div){margin:.15rem 0;line-height:1.6;overflow-wrap:anywhere}
  [data-resultado] :global(small){color:var(--sl-color-gray-3)}
  @media(max-width:62rem){.paneles{grid-template-columns:1fr}}
</style>
