---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
const settingsUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/configuracion/`;
---
<StarlightPage frontmatter={{ title: 'Procesado de Temarios', description: 'Acceso al procesado de temarios.', pagefind: false, editUrl: false, template: 'splash' }}>
  <section data-pagefind-ignore>
    <dialog data-oposicion-loading open aria-labelledby="oposicion-loading-text">
      <div class="carga-oposicion-contenido" role="status" aria-live="polite">
        <span class="carga-oposicion-spinner" aria-hidden="true"></span>
        <p id="oposicion-loading-text">Cargando…</p>
      </div>
    </dialog>
    <noscript><style is:inline>[data-oposicion-loading] { display: none !important; }</style><p>Activa JavaScript para cargar las oposiciones.</p></noscript>
    <p data-private-status role="status">Acceso restringido. Comprueba la conexión con GitHub.</p>
    <div data-private-authorized hidden>
      <div data-oposicion-overview hidden>
      <h2>Paso 1 · Crear oposición</h2>
      <form data-oposicion-form data-oposicion-url={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/oposiciones/`}>
        <label for="nombre-oposicion">Nombre de la oposición</label>
        <input id="nombre-oposicion" name="nombre" maxlength="100" required placeholder="Ej.: TAI" />
        <label for="corto-oposicion">Nombre corto (opcional; si se omite se usa el nombre)</label>
        <input id="corto-oposicion" name="nombreCorto" maxlength="100" placeholder="Ej.: TAI" />
        <button type="submit" disabled>Guardar</button>
      </form>
      <h3>Oposiciones existentes</h3>
      <ul data-oposicion-list></ul>
      </div>
      <div data-oposicion-workspace hidden>
      <p><a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/oposiciones/`}>← Volver a las oposiciones</a></p>
      <h2 data-oposicion-detail></h2>
      <section class="paso-resumen" aria-labelledby="paso-uno-titulo">
        <h3 id="paso-uno-titulo">Paso 1 · Crear oposición <span class="estado-completado">✓ Completado</span></h3>
        <dl>
          <dt>Nombre</dt><dd data-resumen-nombre></dd>
          <dt>Nombre corto</dt><dd data-resumen-corto></dd>
          <dt>Ubicación real en GitHub</dt><dd><a data-resumen-ruta target="_blank" rel="noopener noreferrer"></a></dd>
        </dl>
        <button type="button" data-oposicion-edit-toggle aria-expanded="false">Editar nombre de la oposición</button>
        <form data-oposicion-edit hidden>
          <label for="editar-nombre">Nombre</label>
          <input id="editar-nombre" name="nombre" maxlength="100" required />
          <label for="editar-corto">Nombre corto (URL)</label>
          <input id="editar-corto" name="nombreCorto" maxlength="100" required />
          <button type="submit" disabled>Guardar cambios</button>
        </form>
      </section>
      <section class="paso-resumen" data-resumen-convocatorias hidden>
        <h3>Paso 2 · Convocatorias registradas</h3>
        <ul data-convocatoria-list></ul>
      </section>
      <h3>Paso 2 · Procesar convocatoria oficial</h3>
      <p>Selecciona el PDF completo del BOE de TAI 2025. Se identificará el anexo de ingreso libre, se guardará el original intacto y se generarán metadatos, transcripción, selección y programa oficial. La revisión seguirá pendiente. Puedes eliminar el PDF y sus derivados y repetir el proceso.</p>
      <form data-convocatoria-form>
        <label for="anio-convocatoria">Año de la convocatoria</label>
        <input id="anio-convocatoria" name="anio" type="number" min="1900" max="2199" step="1" required />
        <label for="pdf-convocatoria">Convocatoria oficial en PDF (máximo 20 MB)</label>
        <input id="pdf-convocatoria" name="pdf" type="file" accept="application/pdf,.pdf" required />
        <button type="submit" disabled>Procesar y guardar en GitHub</button>
      </form>
      </div>
      <p data-oposicion-status role="status" aria-live="polite"></p>
    </div>
    <p><a href={settingsUrl}>Configuración de GitHub</a></p>
  </section>
</StarlightPage>
<script>
  import { instalarOposiciones } from '../lib/oposiciones.mjs';
  instalarOposiciones(document);
</script>
<style>
  [data-private-authorized][hidden], [data-private-status][hidden], [data-oposicion-overview][hidden], [data-oposicion-workspace][hidden], form[hidden] { display: none !important; }
  form { display: flex; flex-wrap: wrap; align-items: end; gap: .75rem; }
  label { flex-basis: 100%; }
  input, button { padding: .65rem; border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; background: var(--sl-color-bg); color: var(--sl-color-white); }
  input { width: min(100%, 28rem); }
  button:not(:disabled) { cursor: pointer; background: var(--sl-color-accent-low); }
  .paso-resumen { border: 1px solid var(--sl-color-gray-5); border-inline-start: 4px solid var(--sl-color-accent); border-radius: .5rem; padding: 1rem; margin-block: 1rem; overflow-wrap: anywhere; }
  .paso-resumen[hidden] { display: none !important; }
  .paso-resumen h3 { margin-top: 0; }
  .estado-completado { display: inline-block; font-size: .75rem; color: var(--sl-color-green-high); margin-inline-start: .5rem; }
  button.destacar-procesar { outline: 3px solid #e4b526; outline-offset: 5px; animation: destacar-procesar 1.4s ease-in-out 2; }
  @keyframes destacar-procesar { 0%, 100% { box-shadow: 0 0 0 0 #e4b52600; } 50% { box-shadow: 0 0 0 8px #e4b52640; } }
  @media (prefers-reduced-motion: reduce) { button.destacar-procesar { animation: none; } }
  .paso-resumen dt { font-weight: 600; }
  .paso-resumen dd { margin-inline-start: 0; margin-bottom: .5rem; }
  [data-oposicion-loading] { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 1rem; border: 0; background: color-mix(in srgb, var(--sl-color-bg) 86%, transparent); color: var(--sl-color-white); z-index: 2147483647; }
  [data-oposicion-loading][open] { display: grid; place-items: center; }
  [data-oposicion-loading]:not([open]) { display: none; }
  [data-oposicion-loading]::backdrop { background: transparent; }
  .carga-oposicion-contenido { display: grid; justify-items: center; gap: 1rem; padding: 2rem; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-bg); box-shadow: 0 .5rem 2rem #0003; text-align: center; }
  .carga-oposicion-spinner { width: 2.5rem; height: 2.5rem; border: .25rem solid var(--sl-color-gray-5); border-top-color: var(--sl-color-accent); border-radius: 50%; animation: giro-carga .8s linear infinite; }
  @keyframes giro-carga { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .carga-oposicion-spinner { animation: none; } }
</style>
